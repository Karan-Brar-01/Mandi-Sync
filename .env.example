# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — Python pipeline only; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouteService (Phase 3 arbitrage engine)
OPENROUTESERVICE_API_KEY=your-ors-api-key

# Arbitrage defaults
FUEL_COST_PER_KM=25
DEFAULT_RADIUS_KM=100

# data.gov.in Agmarknet (Phase 2 pipeline)
DATA_GOV_API_KEY=your-data-gov-api-key
